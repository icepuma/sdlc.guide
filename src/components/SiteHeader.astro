---
import ThemeToggle from "./ThemeToggle.astro";

const repositoryUrl = "https://github.com/icepuma/sdlc.guide";
---

<header class="site-header">
  <div class="site-header__identity">
    <a class="site-header__brand" href="/" aria-label="SDLC Guide home">
      <span class="site-header__name">SDLC Guide</span>
    </a>
    <span class="site-header__separator" aria-hidden="true"></span>
    <span class="site-header__tagline">
      <span class="site-header__stage">Work In Progress</span>
      <span class="site-header__tagline-hint">
        An opinionated SDLC built for agentic engineering teams.
      </span>
    </span>
  </div>

  <div class="site-header__actions">
    <nav class="site-header__navigation" aria-label="Primary navigation">
      <a class="site-header__library" href="/library/">Library</a>
      <span class="site-header__nav-separator" aria-hidden="true">/</span>
      <a
        class="site-header__repository"
        href={repositoryUrl}
        aria-label="View icepuma/sdlc.guide on GitHub"
      >
        GitHub
      </a>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
.site-header {
  position: relative;
  z-index: 10;
  display: flex;
  width: min(100%, var(--container-shell));
  align-items: center;
  justify-content: space-between;
  gap: clamp(var(--space-xs), 2vw, var(--space-md));
  margin-inline: auto;
  padding: max(var(--space-lg), env(safe-area-inset-top))
    max(var(--page-gutter), env(safe-area-inset-right)) 0
    max(var(--page-gutter), env(safe-area-inset-left));
}

.site-header__identity {
  display: inline-flex;
  min-width: 0;
  min-height: var(--control-size);
  flex: 1 1 auto;
  align-items: center;
  gap: var(--space-sm);
}

.site-header__brand {
  display: inline-flex;
  min-height: var(--control-size);
  flex: 0 0 auto;
  align-items: center;
  color: var(--ink);
  text-decoration: none;
  transition: color var(--duration-fast) var(--ease-out);
}

.site-header__name {
  flex: 0 0 auto;
  font-family: var(--font-brand);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  letter-spacing: var(--letter-spacing-tight);
  white-space: nowrap;
}

.site-header__separator {
  width: 1px;
  height: var(--space-lg);
  flex: 0 0 auto;
  background: var(--line);
}

.site-header__tagline {
  display: flex;
  min-width: 0;
  flex: 0 1 auto;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-2xs) var(--space-sm) var(--space-2xs) var(--space-2xs);
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: color-mix(in oklch, var(--phase-plan) 10%, var(--background));
  color: var(--ink-soft);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  letter-spacing: 0.01em;
  line-height: var(--line-height-label);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.site-header__stage {
  flex: 0 0 auto;
  padding-inline: var(--space-xs);
  border-radius: var(--radius-pill);
  background: var(--phase-plan);
  color: var(--phase-ink);
  font-weight: var(--font-weight-bold);
  letter-spacing: 0.04em;
  line-height: 1.5;
}

.site-header__tagline-hint {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.site-header__actions,
.site-header__navigation {
  display: flex;
  align-items: center;
}

.site-header__navigation {
  gap: var(--space-xs);
}

.site-header__actions {
  flex: 0 0 auto;
  gap: clamp(var(--space-xs), 2vw, var(--space-lg));
}

.site-header__library,
.site-header__repository {
  display: inline-flex;
  min-height: var(--control-size);
  align-items: center;
  color: var(--ink);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  text-decoration: underline;
  text-decoration-color: color-mix(in oklch, currentColor 45%, transparent);
  text-decoration-thickness: 1px;
  text-underline-offset: 0.28em;
  white-space: nowrap;
  transition:
    color var(--duration-fast) var(--ease-out),
    text-decoration-color var(--duration-fast) var(--ease-out);
}

.site-header__nav-separator {
  color: color-mix(in oklch, var(--ink-soft) 55%, transparent);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-label);
}

.site-header__library:hover,
.site-header__repository:hover,
.site-header__library:focus-visible,
.site-header__repository:focus-visible {
  color: var(--ink-soft);
  text-decoration-color: currentColor;
}

.site-header__brand:hover {
  color: var(--ink-soft);
}

@media (max-width: 47rem) {
  .site-header__identity {
    flex: 0 1 auto;
    gap: var(--space-xs);
  }

  .site-header__separator,
  .site-header__tagline {
    display: none;
  }

  .site-header__actions {
    gap: var(--space-xs);
  }
}
</style>
