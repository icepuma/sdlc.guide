---
import { type LifecycleDocumentId, lifecyclePhases } from "../data/lifecycle";
import { getGuides, guidePath, indexGuides, requireGuide } from "../lib/guides";
import { phasePath } from "../lib/phases";

const guides = await getGuides();
const guideIndex = indexGuides(guides);
const liveGuideCount = guides.length;
const liveGuideLabel = `${liveGuideCount} document guide${liveGuideCount === 1 ? "" : "s"}`;
---

<section class="library-view" aria-labelledby="guides-title">
  <div class="library-view__topline">
    <nav class="library-view__breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Lifecycle</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Guides</span>
    </nav>
    <p class="library-view__count">{liveGuideLabel}</p>
  </div>

  <header class="library-view__intro">
    <h1 id="guides-title">Guides</h1>
    <p>Explore the phases, then use the relevant guides, templates, and examples.</p>
  </header>

  <ul class="library-view__grid" aria-label="Lifecycle guides by phase">
    {lifecyclePhases.map((phase) => (
      <li>
        <article class="library-view__phase" style={`--phase-color: var(${phase.colorVariable})`}>
          <h2 class="library-view__phase-label">
            <a href={phasePath(phase.id)} aria-label={`Read about ${phase.name}`}>
              <span class="library-view__phase-marker" aria-hidden="true"></span>
              <span>{String(phase.index).padStart(2, "0")}</span>
              <span>{phase.name}</span>
            </a>
          </h2>
          <p class="library-view__phase-summary">{phase.summary}</p>

          {phase.documents.length > 0 && (
            <ul class="library-view__guide-list">
              {phase.documents.map((documentId) => {
                const document = requireGuide(guideIndex, documentId as LifecycleDocumentId);

                return (
                  <li>
                    <a
                      href={guidePath(document)}
                      aria-label={`Read ${document.data.abbreviation}: ${document.data.name}`}
                    >
                      <span>{document.data.abbreviation}</span>
                      <span class="library-view__guide-action" aria-hidden="true">read</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
.library-view {
  width: min(100%, var(--container-wide));
  min-width: 0;
  margin-inline: auto;
  padding: 0 max(var(--page-gutter), env(safe-area-inset-right)) var(--article-page-end)
    max(var(--page-gutter), env(safe-area-inset-left));
}

.library-view__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-xs) var(--space-md);
  flex-wrap: wrap;
  padding-block-start: clamp(var(--space-sm), 2vw, var(--space-md));
}

.library-view__breadcrumbs {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: var(--space-xs);
  color: var(--ink-soft);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
}

.library-view__breadcrumbs a {
  display: inline-flex;
  min-block-size: var(--control-size);
  align-items: center;
  color: inherit;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
  transition: color var(--duration-fast) var(--ease-out);
}

.library-view__breadcrumbs a:hover {
  color: var(--ink);
}

.library-view__breadcrumbs > span[aria-hidden] {
  opacity: 0.5;
}

.library-view__breadcrumbs > span[aria-current] {
  color: var(--ink);
  font-weight: var(--font-weight-semibold);
}

.library-view__count {
  color: var(--ink-soft);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  letter-spacing: var(--letter-spacing-label);
  line-height: var(--line-height-label);
  white-space: nowrap;
}

.library-view__intro {
  max-width: 40rem;
  padding-block: var(--space-xl) var(--space-lg);
}

.library-view__intro h1 {
  font-size: var(--font-size-heading);
  font-weight: var(--font-weight-bold);
  letter-spacing: var(--letter-spacing-tight);
  line-height: var(--line-height-tight);
}

.library-view__intro p {
  margin-block-start: var(--space-sm);
  color: var(--ink-soft);
  font-size: var(--font-size-base);
  line-height: var(--line-height-body);
}

.library-view__grid,
.library-view__guide-list {
  padding: 0;
  list-style: none;
}

.library-view__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  align-items: start;
  gap: var(--space-lg);
}

.library-view__phase {
  --phase-color: var(--line);
  display: grid;
  align-content: start;
  padding: var(--space-lg);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.library-view__phase-label {
  display: flex;
  margin: 0;
  color: var(--ink-soft);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--letter-spacing-label);
  line-height: var(--line-height-label);
}

.library-view__phase-label a {
  display: flex;
  min-block-size: var(--control-size);
  align-items: center;
  gap: var(--space-xs);
  color: inherit;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
  transition: color var(--duration-fast) var(--ease-out);
}

.library-view__phase-label a:hover {
  color: var(--ink);
}

.library-view__phase-marker {
  width: var(--space-xs);
  height: 0.2rem;
  flex: 0 0 auto;
  border-radius: var(--radius-pill);
  background: var(--phase-color);
}

.library-view__phase-summary {
  margin-block: var(--space-xs) 0;
  color: var(--ink-soft);
  font-size: var(--font-size-base);
  line-height: var(--line-height-body);
}

.library-view__guide-list {
  display: grid;
  margin-block-start: var(--space-sm);
}

.library-view__guide-list li + li > * {
  border-block-start: 1px solid color-mix(in oklch, var(--line) 55%, transparent);
}

.library-view__guide-list li:first-child > * {
  border-block-start: 1px solid color-mix(in oklch, var(--line) 55%, transparent);
}

.library-view__guide-list a {
  display: flex;
  min-block-size: var(--control-size);
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  color: var(--ink);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  line-height: var(--line-height-label);
}

.library-view__guide-list a {
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
  transition: color var(--duration-fast) var(--ease-out);
}

.library-view__guide-list a:hover {
  color: var(--ink-soft);
}

.library-view__guide-action {
  flex: 0 0 auto;
  color: var(--phase-color);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
}

@media (max-width: 26rem) {
  .library-view__topline {
    align-items: flex-start;
  }

  .library-view__count {
    min-block-size: var(--control-size);
    padding-block: 0;
  }

  .library-view__phase {
    min-height: 0;
  }
}
</style>
