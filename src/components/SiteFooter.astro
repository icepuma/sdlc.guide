---
const repositoryUrl = "https://github.com/icepuma/sdlc.guide";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <span class="site-footer__label">Repository</span>
    <a href={repositoryUrl} aria-label="View icepuma/sdlc.guide on GitHub"> icepuma/sdlc.guide </a>
  </div>
</footer>

<style>
.site-footer {
  width: min(100%, var(--container-shell));
  margin-inline: auto;
  padding: 0 max(var(--page-gutter), env(safe-area-inset-right))
    max(var(--space-md), env(safe-area-inset-bottom))
    max(var(--page-gutter), env(safe-area-inset-left));
}

.site-footer__inner {
  display: flex;
  min-height: var(--space-3xl);
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  border-block-start: 1px solid color-mix(in oklch, var(--line) 72%, transparent);
}

.site-footer__label {
  color: var(--ink-soft);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--letter-spacing-label);
  line-height: var(--line-height-label);
  text-transform: uppercase;
}

.site-footer a {
  display: inline-flex;
  min-height: var(--control-size);
  align-items: center;
  color: var(--ink);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-label);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
  transition: color var(--duration-fast) var(--ease-out);
}

.site-footer a:hover {
  color: var(--ink-soft);
}
</style>
