---
import { getEntries } from "astro:content";
import { type GuideEntry, guideColorVariable, guidePath } from "../lib/guides";

interface Props {
  guide: GuideEntry;
}

const { guide } = Astro.props;
const { data } = guide;
const lifecycleHref = `/#${data.phase}`;
const factLeads = ["Also called", "Written by", "Ideal length", "Shelf life"] as const;
const quickFacts = data.facts
  .map((fact, index) => `${factLeads[index] ?? fact.label}: ${fact.value}`)
  .join(". ");
const relatedGuides = await getEntries(data.related.map((related) => related.guide));
---

<article class="guide-article" style={`--guide-color: var(${guideColorVariable(guide)})`}>
  <div class="guide-article__pretitle">
    <nav aria-label="Breadcrumb">
      <ol class="guide-article__breadcrumbs">
        <li><a href={lifecycleHref}>Lifecycle</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{data.abbreviation}</li>
      </ol>
    </nav>
  </div>

  <header class="guide-article__header">
    <h1>{data.name}</h1>
    <p class="guide-article__tagline">{data.tagline}</p>
  </header>

  <section class="guide-block" id="what" aria-labelledby="summary-title">
    <header class="guide-block__heading">
      <h2 id="summary-title">Summary</h2>
    </header>

    <div class="guide-summary">
      <p><strong>At a glance.</strong> {quickFacts}.</p>
      <p id="tpl">
        <strong>Template.</strong> {data.template.note}{" "}
        <a href={data.template.href} download={data.template.fileName}>
          Download {data.template.fileName} ↓
        </a>
      </p>
      {data.overview.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p><strong>In short.</strong> {data.overview.takeaway}</p>
      <p id="when"><strong>Use it when.</strong> {data.overview.useWhen.join("; ")}.</p>
      <p><strong>Skip it when.</strong> {data.overview.skipWhen.join("; ")}.</p>
      <p id="anatomy">
        <strong>What it contains.</strong>
        {data.overview.anatomy
            .map((item) => `${item.term}: ${item.description}`)
            .join(" ")}
      </p>
      <p id="dodont">
        <strong>Write it well.</strong> {data.overview.dos.join("; ")}. <strong>Avoid.</strong>
        {data.overview.donts.join("; ")}.
      </p>
      <p id="rel">
        <strong>Related.</strong>{" "}
        {data.related.map((related, index) => {
          const relatedGuide = relatedGuides[index];
          if (!relatedGuide) throw new Error(`Related guide is missing: ${related.guide.id}`);

          return (
            <span>
              {index > 0 && " "}
              <a href={guidePath(relatedGuide)}>{relatedGuide.data.abbreviation}</a>
              {` — ${related.description}`}
            </span>
          );
        })}
      </p>
      <p>
        <strong>Sources.</strong>{" "}
        {data.sources.map((source, index) => (
          <span>
            {index > 0 && " · "}
            <a href={source.url}>{source.label}</a>
          </span>
        ))}
      </p>
    </div>
  </section>

  <section class="guide-block" id="wild" aria-labelledby="example-title">
    <header class="guide-block__heading">
      <h2 id="example-title">Full example</h2>
    </header>

    <article class="guide-example" aria-label={`Example: ${data.example.documentTitle}`}>
      <header class="guide-example__bar">
        <span>{data.example.fileName}</span>
        <span>Complete document</span>
      </header>
      <div class="guide-example__document">
        <h3>{data.example.documentTitle}</h3>
        <p class="guide-example__meta">{data.example.documentMeta}</p>
        <div class="guide-example__content">
          <slot />
        </div>
      </div>
    </article>
  </section>
</article>

<style>
.guide-article {
  width: min(100%, var(--container-reading));
  min-width: 0;
  margin-inline: auto;
  padding: 0 max(var(--page-gutter), env(safe-area-inset-right))
    clamp(var(--space-2xl), 6vw, var(--space-3xl))
    max(var(--page-gutter), env(safe-area-inset-left));
}

.guide-article__pretitle a,
.guide-summary a {
  color: inherit;
}

.guide-article__pretitle {
  padding-block-start: clamp(var(--space-md), 3vw, var(--space-lg));
}

.guide-article__breadcrumbs {
  display: flex;
  padding: 0;
  align-items: center;
  gap: var(--space-xs);
  color: var(--ink-soft);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  list-style: none;
}

.guide-article__pretitle a {
  display: inline-flex;
  min-block-size: var(--control-size);
  align-items: center;
  color: var(--ink-soft);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
  transition: color var(--duration-fast) var(--ease-out);
}

.guide-article__pretitle a:hover {
  color: var(--ink);
}

.guide-article__breadcrumbs > li[aria-hidden] {
  opacity: 0.5;
}

.guide-article__breadcrumbs > li[aria-current] {
  color: var(--guide-color);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  letter-spacing: var(--letter-spacing-label);
  line-height: var(--line-height-label);
  text-transform: uppercase;
}

.guide-article__header {
  padding-block: clamp(var(--space-sm), 2vw, var(--space-lg))
    clamp(var(--space-lg), 4vw, var(--space-xl));
}

.guide-article__header h1 {
  max-width: 42rem;
  margin: 0;
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  letter-spacing: var(--letter-spacing-tight);
  line-height: var(--line-height-tight);
}

.guide-article__tagline {
  margin-block-start: var(--space-md);
  color: var(--ink-soft);
  font-size: var(--font-size-lg);
  line-height: var(--line-height-body);
}

.guide-block {
  scroll-margin-block-start: var(--space-lg);
  margin-block-end: clamp(var(--space-2xl), 8vw, var(--space-4xl));
}

.guide-block:last-child {
  margin-block-end: 0;
}

.guide-block__heading {
  margin-block-end: var(--space-lg);
  padding-block-end: var(--space-sm);
  border-block-end: 1px solid var(--line);
}

.guide-block__heading h2 {
  font-size: var(--font-size-section);
  font-weight: var(--font-weight-bold);
  letter-spacing: var(--letter-spacing-heading);
  line-height: var(--line-height-tight);
}

.guide-summary {
  display: grid;
  gap: var(--space-md);
}

.guide-summary > p {
  font-size: var(--font-size-base);
  line-height: var(--line-height-body);
  scroll-margin-block-start: var(--space-lg);
}

.guide-summary strong {
  font-weight: var(--font-weight-semibold);
}

.guide-summary a {
  color: var(--guide-color);
  font-weight: var(--font-weight-semibold);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
}

.guide-example {
  border-block: 1px solid var(--line);
  background: color-mix(in oklch, var(--surface) 72%, transparent);
}

.guide-example__bar {
  display: flex;
  justify-content: space-between;
  gap: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-block-end: 1px solid var(--line);
  color: var(--ink-soft);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-label);
}

.guide-example__bar > span:last-child {
  letter-spacing: var(--letter-spacing-label);
  text-transform: uppercase;
}

.guide-example__document {
  padding: clamp(var(--space-md), 3vw, var(--space-lg));
}

.guide-example__document h3 {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--letter-spacing-heading);
  line-height: var(--line-height-tight);
}

.guide-example__meta {
  margin-block: var(--space-2xs) var(--space-lg);
  color: var(--ink-soft);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-label);
}

.guide-example__content :global(h4) {
  margin: var(--space-lg) 0 var(--space-2xs);
  color: var(--guide-color);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--letter-spacing-label);
  line-height: var(--line-height-label);
  text-transform: uppercase;
}

.guide-example__content :global(h4:first-child) {
  margin-block-start: 0;
}

.guide-example__content :global(p) {
  font-size: var(--font-size-base);
  line-height: var(--line-height-body);
}

.guide-example__content :global(ul) {
  display: grid;
  gap: var(--space-xs);
  margin: var(--space-sm) 0 0;
  padding-inline-start: var(--space-lg);
}

.guide-example__content :global(li) {
  font-size: var(--font-size-base);
  line-height: var(--line-height-body);
}
</style>
