---
import GuideArticle from "../../components/GuideArticle.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { type GuideEntry, getGuides, guideTopic } from "../../lib/guides";

interface Props {
  guide: GuideEntry;
}

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => {
    const topic = guideTopic(guide);
    return {
      params: { phase: topic.phase, slug: topic.slug },
      props: { guide },
    };
  });
}

const { guide } = Astro.props;
---

<BaseLayout
  title={`${guide.data.abbreviation}: ${guide.data.name}`}
  description={guide.data.tagline}
>
  <div class="guide-page">
    <SiteHeader />
    <GuideArticle guide={guide} />
  </div>
</BaseLayout>

<style>
.guide-page {
  min-width: 0;
  min-height: 100%;
}
</style>
